# 签名密钥（绝对不能上传）
*.keystore

# AI 生成资产脚本（含 DashScope / ElevenLabs / Suno API Key，禁止入库）
# 已审计 20 个含 key 的脚本，全部命中下方 3 个 glob
gen_*.py
generate_*.py
upgrade_*.py
*_api_key.py
voice_errors.log

# Ren'Py 编译缓存
game/cache/
game/**/*.rpyc
__pycache__/
*.pyc

# 存档文件（本地数据）
game/saves/

# 备份文件
*.bak
*.bak.*

# 日志/错误
log.txt
errors.txt
traceback.txt

# Android 构建配置（含本地路径）
.android.json

# 系统文件
.DS_Store
Thumbs.db

# Ren'Py 临时文件
tmp/

# 工具脚本扫描输出 (每次跑会变, 不入库)
crisis_candidates.txt
ai_smell_scan_*.txt
first_meet_report_*.txt
missing_portraits_*.txt
missing_portraits_*.json

# 临时验证脚本 (会 override splashscreen, 绝不能入库)
game/_tmp_verify.rpy
game/_tmp_*.rpy
